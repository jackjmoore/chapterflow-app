{
  "name": "chapterflow-app",
  "version": "0.1.0",
  "description": "Electron + React + TypeScript desktop app",
  "main": "./out/main/index.js",
  "author": "chapterflow-app",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "test:build": "esbuild tests/export.test.ts tests/compile.test.ts tests/book.test.ts tests/bookRender.test.ts tests/compileStore.test.ts tests/structure.test.ts tests/editorfeatures.test.ts tests/pdf.test.ts tests/pagination.test.ts tests/pageview.test.ts tests/revision.test.ts tests/freshness.test.ts tests/live.test.ts tests/lexicon.test.ts tests/searchIndex.test.ts tests/searchRank.test.ts tests/searchUi.test.ts tests/uiPolish.test.ts tests/dashboard.test.ts tests/scrivenerMetadata.test.ts tests/scrivenerRtf.test.ts --bundle --platform=node --format=cjs --outdir=node_modules/.cache/chapterflow-tests --out-extension:.js=.cjs --external:electron && esbuild tests/pagination.browser.ts --bundle --format=iife --global-name=__paginationChecks --outfile=node_modules/.cache/chapterflow-tests/pagination.browser.cjs && esbuild tests/pageview.browser.ts --bundle --format=iife --global-name=__pageviewChecks --outfile=node_modules/.cache/chapterflow-tests/pageview.browser.cjs && esbuild tests/revision.browser.ts --bundle --format=iife --global-name=__revisionChecks --outfile=node_modules/.cache/chapterflow-tests/revision.browser.cjs && esbuild tests/editorfeatures.browser.ts --bundle --format=iife --global-name=__editorfeaturesChecks --outfile=node_modules/.cache/chapterflow-tests/editorfeatures.browser.cjs",
    "test:prepare": "npm run build && npm run test:build",
    "test:export": "node scripts/run-tests.mjs export",
    "test:compile": "node scripts/run-tests.mjs compile",
    "test:compilestore": "node scripts/run-tests.mjs compilestore",
    "test:book": "node scripts/run-tests.mjs book",
    "test:bookrender": "node scripts/run-tests.mjs bookrender",
    "test:structure": "node scripts/run-tests.mjs structure",
    "test:pdf": "node scripts/run-tests.mjs pdf",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:pagination": "node scripts/run-tests.mjs pagination",
    "test:pageview": "node scripts/run-tests.mjs pageview",
    "test:revision": "node scripts/run-tests.mjs revision",
    "test:editorfeatures": "node scripts/run-tests.mjs editorfeatures",
    "test:freshness": "node scripts/run-tests.mjs freshness",
    "test:live": "node scripts/run-tests.mjs live",
    "test:lexicon": "node scripts/run-tests.mjs lexicon",
    "test:search": "node scripts/run-tests.mjs search",
    "test:rank": "node scripts/run-tests.mjs rank",
    "test:searchui": "node scripts/run-tests.mjs searchui",
    "test:polish": "node scripts/run-tests.mjs polish",
    "test:scrivmeta": "node scripts/run-tests.mjs scrivmeta",
    "test:scrivrtf": "node scripts/run-tests.mjs scrivrtf",
    "test:dashboard": "node scripts/run-tests.mjs dashboard"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "diff": "^5.2.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "hyphen": "^1.14.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "node-html-parser": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "rtf-stream-parser": "^4.0.0",
    "three": "^0.185.1",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/vollkorn": "^5.3.0",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron@43.4.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
