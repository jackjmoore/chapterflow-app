{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ]
  },
  "exclude": [
    "tests/pagination.browser.ts",
    "tests/pageview.browser.ts",
    "tests/revision.browser.ts",
    "tests/editorfeatures.browser.ts"
  ]
}
